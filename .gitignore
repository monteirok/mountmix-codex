# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
.npm-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/

# Cloudflare local secrets
.dev.vars
.dev.vars.*

# Package-manager authentication
.npmrc
.yarnrc.yml
.pnpmrc

# Authentication files
.netrc
.authinfo
.sentryclirc
.secrets/
secrets/

# Private keys and certificate stores
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*

# Service credentials
credentials.json
service-account*.json
client_secret_*.json

# Local databases and journals
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Potentially sensitive logs and exports
*.log
*.dump
*.backup
*.bak

/work/